@startuml
!pragma layout smetana
title Rota — classes persistidas no código (v2)
skinparam shadowing false
skinparam backgroundColor #FAFBFC
hide circle

package br.com.rota.model {
  enum Role {
    CLIENT
    COMPANY
    BANK
  }
  enum OrderStatus {
    PENDING
    APPROVED
    REJECTED
    CONTRACTED
    CANCELLED
  }
  class AppUser <<Entity>> {
    id: UUID
    username: String
    passwordHash: String
    name: String
    role: Role
    rg: String
    cpf: String
    address: String
    profession: String
    active: boolean
    version: long
  }
  class Employment <<Embeddable>> {
    employer: String
    income: BigDecimal
  }
  class Vehicle <<Entity>> {
    id: UUID
    registration: String
    year: int
    brand: String
    model: String
    plate: String
    dailyRate: BigDecimal
    category: String
    version: long
  }
  class RentalOrder <<Entity>> {
    id: UUID
    startDate: LocalDate
    endDate: LocalDate
    totalAmount: BigDecimal
    status: OrderStatus
    notes: String
    reviewNotes: String
    createdAt: Instant
    version: long
  }
  class RentalContract <<Entity>> {
    id: UUID
    signedAt: Instant
    creditAmount: BigDecimal [0..1]
    interestRate: BigDecimal [0..1]
    installments: Integer [0..1]
  }
}

AppUser --> Role
AppUser "1" *-- "0..3" Employment : employments
AppUser "1" <-- "0..*" Vehicle : owner
AppUser "1" <-- "0..*" RentalOrder : client
AppUser "0..1" <-- "0..*" RentalOrder : reviewedBy
Vehicle "1" <-- "0..*" RentalOrder : vehicle
RentalOrder --> OrderStatus
RentalOrder "1" <-- "0..1" RentalContract : order
AppUser "1" <-- "0..*" RentalContract : owner
AppUser "0..1" <-- "0..*" RentalContract : bank

note right of AppUser
  CLIENT: identificação e empregadores.
  COMPANY/BANK: agentes.
  Não existe entidade Client separada.
end note
note right of Employment
  @ElementCollection: tabela employments.
  Máximo 3 validado no serviço.
end note
note bottom of RentalContract
  Crédito é opcional e embutido no contrato.
  bank deve possuir Role.BANK;
  a concessão exige esse banco autenticado.
end note
note bottom of Vehicle
  owner registra a propriedade corrente.
  RentalContract.owner preserva a
  propriedade definida na contratação.
end note
@enduml
