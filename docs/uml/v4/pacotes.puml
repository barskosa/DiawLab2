@startuml
!pragma layout smetana
title Rota — pacotes e Design System em 04/11/2026 (v4)
skinparam shadowing false
skinparam backgroundColor #FAFBFC

package "Construção dinâmica de páginas web\nfrontend/src — View" as Front {
  component "main.jsx" as Main
  component "App.jsx" as App
  component "Auth.jsx" as Auth
  component "forms.jsx" as Forms
  component "components.jsx" as Components
  component "ClientFinancialSummary.jsx" as FinancialSummary
  component "api.js" as Api
  component "Theme.jsx" as Theme
  component "DesignSystem.jsx" as DesignSystem
  component "design-utils.js" as DesignUtils
  artifact "tokens.css / styles.css" as Tokens
  artifact "design-system.css" as DesignStyles

  Main --> App
  Main --> Theme
  Main --> Components
  Main ..> DesignSystem : /design — carregamento lazy
  Main ..> Tokens
  App --> Auth
  App --> Theme
  App --> Forms
  App --> Components
  App --> FinancialSummary
  App --> Api
  Auth --> Theme
  Auth --> Forms
  Auth --> Components
  Auth --> Api
  Forms --> Components
  Forms --> FinancialSummary
  FinancialSummary --> Components
  FinancialSummary --> Api
  Theme --> Components
  DesignSystem --> Theme
  DesignSystem --> Components
  DesignSystem --> DesignUtils
  DesignSystem ..> DesignStyles
}
package "Gestão de pedidos e contratos\nbackend/src/main/java/br/com/rota" as Back {
  package controller {
    component "AuthController" as AuthController
    component "ClientController" as ClientController
    component "VehicleController" as VehicleController
    component "OrderController" as OrderController
    component "ContractController" as ContractController
  }
  package service {
    component "AuthService" as AuthService
    component "RentalService" as RentalService
    component "RentalDates" as RentalDates
    RentalService --> AuthService
    RentalService --> RentalDates
    AuthService --> RentalDates
  }
  package model {
    component "AppUser / Employment" as Users
    component "Vehicle / RentalOrder / RentalContract" as Models
    component "Role / OrderStatus" as Enums
  }
  package repository {
    component "UserRepository" as UserRepository
    component "VehicleRepository / OrderRepository / ContractRepository" as Repositories
  }
  package dto {
    component "ApiDtos" as Dtos
  }
  package config {
    component "SecurityConfig" as Security
  }
  package exception {
    component "ApiException / ApiExceptionHandler" as Errors
  }
}
database "Supabase PostgreSQL\nesquema rental" as Db
artifact "frontend/public/\ndesign-system-rota.pdf" as Pdf
component "Flyway — db/migration\nV1: estrutura inicial\nV2: condições contratuais preservadas" as Flyway

Api --> controller : HTTP JSON + sessão + CSRF
Security ..> controller : filtros e sessão
controller ..> Dtos
AuthController --> AuthService
ClientController --> AuthService
VehicleController --> RentalService
VehicleController --> AuthService
OrderController --> RentalService
ContractController --> RentalService
service ..> Dtos
service --> model
service --> repository
service ..> Errors
repository --> model
repository --> Db : JDBC / SSL
Flyway --> Db : migrações versionadas
DesignSystem ..> Pdf : download estático

note bottom of DesignSystem
  Referência pública de identidade e componentes.
  Sem acesso aos dados de clientes/pedidos.
  Impressão usa window.print no tema atual.
end note
note bottom of Theme
  ThemeProvider envolve App e DesignSystem.
  Preferência claro/escuro: rota.theme.
  Somente essa preferência usa localStorage.
end note
note bottom of Models
  Entidades e casos de uso de negócio
  permanecem representados na v3.
end note
@enduml
