# Copie este arquivo para .env DENTRO de backend/.
# Supabase > Connect > Session pooler > JDBC. Copie host e usuario exatos.
# Nao coloque usuario/senha na URL: use os campos separados abaixo.
DB_URL=jdbc:postgresql://SEU-HOST.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.SEU_PROJECT_REF
DB_PASSWORD=SUA_SENHA_DO_BANCO

# Escolha um codigo privado para autorizar o cadastro de bancos e empresas.
# Sem codigo configurado, apenas clientes podem se cadastrar.
APP_AGENT_REGISTRATION_CODE=

# API local. Em producao HTTPS, use SESSION_COOKIE_SECURE=true.
FRONTEND_ORIGIN=http://localhost:5173
SERVER_PORT=8080
SESSION_COOKIE_SECURE=false
